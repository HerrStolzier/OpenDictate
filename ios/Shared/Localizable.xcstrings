{
  "sourceLanguage": "en",
  "strings": {
    "Dictate": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktieren"
          }
        }
      }
    },
    "Keep Microphone Warm": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikro warm halten"
          }
        }
      }
    },
    "Keeps the microphone ready for the OpenDictate keyboard for the time set in the app. Run it again to turn the microphone off.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält das Mikrofon für die OpenDictate-Tastatur so lange bereit, wie in der App eingestellt. Nochmal ausführen schaltet es aus."
          }
        }
      }
    },
    "Starts a dictation. Run it again to stop; it then returns the text for “Copy to Clipboard”.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet ein Diktat. Führ die Aktion nochmal aus, um es zu beenden. Sie gibt dann den Text für „In Zwischenablage kopieren“ weiter."
          }
        }
      }
    },
    "Stop dictation": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktat beenden"
          }
        }
      }
    }
  },
  "version": "1.0"
}
