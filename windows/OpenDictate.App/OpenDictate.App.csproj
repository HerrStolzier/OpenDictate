<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- 64-bit only: the window style calls use the *LongPtr entry points. -->
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>OpenDictate.ico</ApplicationIcon>
    <AssemblyName>OpenDictate</AssemblyName>
    <RootNamespace>OpenDictate.App</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../OpenDictate.Core/OpenDictate.Core.csproj" />
    <ProjectReference Include="../OpenDictate.Provider/OpenDictate.Provider.csproj" />
    <ProjectReference Include="../OpenDictate.Windows/OpenDictate.Windows.csproj" />
    <!-- Brand fonts from the design system copy (SIL Open Font License). -->
    <Resource Include="../../design/fonts/*.ttf" Link="Fonts/%(Filename)%(Extension)" />
    <None Include="../../design/fonts/OFL.txt" Link="Fonts/OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="OpenDictate.ico" />
  </ItemGroup>
</Project>
