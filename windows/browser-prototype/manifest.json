{
  "manifest_version": 3,
  "name": "OpenDictate – lokale Browserprobe",
  "version": "0.1.0",
  "description": "Lokale Testanbindung an OpenDictate. Nur für die isolierte Browserprobe.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Mit OpenDictate verbinden"
  }
}
