# Example Hyprland bind for OpenDictate (classic hyprland.conf syntax).
# Copy the line into your Hyprland config and pick a free key first.
# The Arch package installs the program as /usr/bin/opendictate.

bind = SUPER, D, exec, opendictate toggle

# Alternative: hold to record (choose this pair instead of the toggle bind).
# Release D before the modifier; classic bindr follows the same chord.
# bind = SUPER, D, exec, opendictate start
# bindr = SUPER, D, exec, opendictate stop
