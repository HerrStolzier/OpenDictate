{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/review-gate.py\"",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "mcp__.*github.*__(merge_pull_request|enable_pr_auto_merge|push_files|create_or_update_file|delete_file)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/review-gate.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
